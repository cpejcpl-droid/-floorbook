# Copy this file to .env and fill in real values. Never commit .env.

# Gmail account that will send booking notifications (e.g. cpe.jcpl@gmail.com)
GMAIL_USER=cpe.jcpl@gmail.com

# A 16-character Gmail "App Password" — NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Always CC'd on every booking notification
SUPERVISOR_EMAIL=cpe.jcpl@gmail.com

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# --- WhatsApp (via Twilio) ---
# From https://console.twilio.com — Account SID and Auth Token
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio WhatsApp-enabled number, in the form "whatsapp:+14155238886"
# The Twilio Sandbox number above works for testing without approval.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Always gets a WhatsApp copy too, in the form "whatsapp:+919876543210"
SUPERVISOR_WHATSAPP=whatsapp:+919876543210

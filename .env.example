# Copy this file to .env and fill in real values. Never commit .env.

# Gmail account that will send booking notifications (e.g. cpe.jcpl@gmail.com)
GMAIL_USER=cpe.jcpl@gmail.com

# A 16-character Gmail "App Password" — NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the account)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Always CC'd on every booking notification
SUPERVISOR_EMAIL=cpe.jcpl@gmail.com

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# --- Telegram (free, no phone verification) ---
# From @BotFather on Telegram after running /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# The supervisor's numeric Telegram ID (get it by messaging @userinfobot)
SUPERVISOR_TELEGRAM_ID=987654321
